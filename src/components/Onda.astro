---
// Separador orgánico entre secciones: se superpone al final de la sección anterior
// con el color de la siguiente, así las plantas de abajo quedan "plantadas" en la onda.
type Color = "morado" | "morado-oscuro" | "verde" | "crema" | "blanco";

interface Props {
  hacia: Color;
  forma?: 1 | 2;
}

const { hacia, forma = 1 } = Astro.props;
const formas = {
  1: "M0,40 C240,100 480,0 720,40 C960,80 1200,10 1440,50 L1440,100 L0,100 Z",
  2: "M0,60 C300,0 600,100 900,50 C1140,10 1300,70 1440,30 L1440,100 L0,100 Z",
};
---

<div class="onda" aria-hidden="true">
  <svg viewBox="0 0 1440 100" preserveAspectRatio="none">
    <path d={formas[forma]} fill={`var(--${hacia})`}></path>
  </svg>
</div>
